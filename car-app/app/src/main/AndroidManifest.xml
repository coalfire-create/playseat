<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Pleos Connect 퍼미션. 이름은 pleos.car.permission.{상수} 형식입니다.
      맨이름(CAR_SEATS)으로 선언하면 안 됩니다 — 공식 문서 Declaring permission 참조.
      실제 신호 수신은 PleosVehicleSignalSource 에서만 사용하며,
      SDK 미연결 상태에서는 FakeVehicleSignalSource 로 동작합니다.
    -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      TODO(제출 전): required="true" 로 바꿉니다.
      개발 중에는 일반 휴대폰 AVD 에서도 설치해 Fake 신호로 UI를 확인할 수 있도록 false 로 둡니다.
    -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlaySeat">

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PlaySeat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              주행 중에도 화면을 유지하기 위한 선언입니다.
              이 선언이 없으면 AAOS 가 기어 D 진입 시 앱 전체를
              "주행 중에는 사용할 수 없습니다" 안내로 덮어버립니다.
              (Pleos Connect v2.1.0 에뮬레이터에서 확인)

              선언의 전제는 CarScreen.DrivingView 가 지키고 있습니다.
              주행 중에는 목록·검색·키보드를 걷어내고 터치 타깃을 2개로 줄이며,
              선곡 조작 자체가 동승자 폰으로 넘어갑니다. 운전자 화면에는
              지금 재생 중인 곡과 다음 차례만 남습니다.
            -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
